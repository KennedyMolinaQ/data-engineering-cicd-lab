# Plantilla de variables de entorno. Copia a `.env` (que está gitignored) y
# rellena con tus valores. NO subas el `.env` real al repositorio.

# Entorno lógico de la app: dev | staging | prod
APP_ENV=dev

# Catálogo Unity destino
CATALOGO=dev

# Ruta a los datos de entrada
RUTA_DATOS=08-sample-data/csv/ventas.csv

# Databricks (para despliegue local; en CI se usan GitHub Secrets)
DATABRICKS_HOST=https://tu-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=  <-- nunca lo pongas aquí en texto plano; usa `databricks auth login`
